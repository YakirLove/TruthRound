{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "TruthRound",
  "version": "0.2.0",
  "identifier": "com.truthround.game",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5183",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "真相圆桌",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "fullscreen": false,
        "minWidth": 1024,
        "minHeight": 700
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "../LICENSE": "licenses/TRUTHROUND-LICENSE.txt",
      "../docs/licenses/PIXI-VN-LICENSE.txt": "licenses/PIXI-VN-LICENSE.txt",
      "../docs/THIRD_PARTY.md": "THIRD_PARTY.md"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
